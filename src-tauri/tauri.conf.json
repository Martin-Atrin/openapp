{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenApp",
  "version": "0.1.2",
  "identifier": "com.polygonface.openapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenApp",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "files": {
        "MacOS/msb": "vm/runtime/bin/msb",
        "Frameworks/libkrunfw.5.dylib": "vm/runtime/lib/libkrunfw.5.dylib",
        "MacOS/openapp-macos": "target/macos-services/release/openapp-macos",
        "Helpers/OpenAppNotify.app": "target/macos-services/OpenAppNotify.app"
      }
    }
  }
}
